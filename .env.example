# ─────────────────────────────────────────────────────────────────────────────
# ORBITAL-AI — Environment Variable Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env or any real secret to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Optional vision-provider compatibility path ───────────────────────────────
# Leave blank for the free specialist-only path.
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=
# OPENAI_API_BASE=

# ── Python FastAPI Backend URL ────────────────────────────────────────────────
# Base URL of the running FastAPI deep-learning backend.
# Include protocol and host only — no trailing slash, no path.
#   Local dev:   http://127.0.0.1:8000
#   Render:      https://your-app.onrender.com
#   Railway:     https://your-app.up.railway.app
# Leave blank to disable live Python backend proxy (Vercel standalone mode).
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# ── Frontend API Base URL (Vite client-side) ──────────────────────────────────
# The URL the browser will use to reach the Node/Express or Vercel API.
# In Vite dev mode this is usually the same origin (leave blank for relative calls).
# On Vercel deployment: set to your deployed frontend URL.
VITE_API_BASE_URL=http://localhost:8787
# Alias kept for backward compatibility
VITE_API_URL=http://localhost:8787

# ── Node/Express Server Port ──────────────────────────────────────────────────
API_PORT=8787

# ── CORS (FastAPI backend) ────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Python FastAPI backend.
# Set to '*' (default) to allow any origin (suitable for open dev/judging).
# Example for production with specific frontend: https://satquery.vercel.app
CORS_ORIGINS=*

# ── Building Detector Model Path ─────────────────────────────────────────────
# Path to YOLO segmentation weights. Relative paths are resolved from project root.
# Default: backend/models/building_model.pt
BUILDING_MODEL_PATH=backend/models/building_model.pt

# ── AdaptLLM Remote-Sensing VLM Specialist (optional) ────────────────────────
# PRODUCTION/JUDGING MODE: false — AdaptLLM is disabled unless local weights
# are explicitly installed and this flag is set to true.
# Set ADAPTLLM_MODEL_PATH to the on-disk weights directory when enabling.
# Model NEVER auto-downloads weights regardless of this flag.
ENABLE_ADAPTLLM=false
# ADAPTLLM_MODEL_PATH=backend/models/generalist/adaptllm

# ── Session Call Limit ────────────────────────────────────────────────────────
# Soft per-session VLM call guard. Default production/demo value is 100 to allow
# comprehensive evaluation sessions while protecting against runaway loops.
SESSION_CALL_LIMIT=100
VITE_SESSION_CALL_LIMIT=100

# ── Frontend Origin (for Node server CORS) ────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Free Hugging Face ZeroGPU Worker ─────────────────────────────────────────
# Set true after creating the free personal ZeroGPU Space described in hf_space/.
# The worker runs adapted VQA/captioning plus explicitly-labelled classical baselines.
ENABLE_HF_RS_WORKER=true
# Optional override if the Space URL changes.
# HF_RS_WORKER_URL=https://cattolatte-satquery.hf.space

# ── Supabase Data Plane ───────────────────────────────────────────────────────
# Optional. Use the publishable key only; NEVER expose a service-role key.
# When configured, sessions/results can persist in Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Phase 4: PostgreSQL Database ──────────────────────────────────────────────
# Connection string for the PostgreSQL database.
# The application runs without a database (in-memory mode) if not set.
# Example: postgresql://postgres:password@localhost:5432/satquery
DATABASE_URL=

# PostgreSQL connection pool settings
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Session and cache TTL in minutes (default: 30)
SESSION_TTL_MINUTES=30
CACHE_TTL_MINUTES=30
