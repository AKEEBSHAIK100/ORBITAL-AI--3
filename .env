OPENAI_VISION_MODEL=claude-3-5-sonnet-20241022

PYTHON_BACKEND_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://localhost:8787
# Alias kept for backward compatibility
VITE_API_URL=http://localhost:8787

API_PORT=8787

# ── CORS (FastAPI backend) ────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Python FastAPI backend.
# Set to '*' (default) to allow any origin (suitable for open dev/judging).
# Example for production with specific frontend: https://satquery.vercel.app
CORS_ORIGINS=*

# ── Building Detector Model Path ─────────────────────────────────────────────
# Path to YOLO segmentation weights. Relative paths are resolved from project root.
# Default: backend/models/building_model.pt
BUILDING_MODEL_PATH=backend/models/building_model.pt

# ── Synthetic Fallback Gate ───────────────────────────────────────────────────
# PRODUCTION/JUDGING MODE: false — returns a structured MODEL_UNAVAILABLE error
# rather than silently replacing a real specialist with heuristic estimates.
# Set to true only for local dev/preview when models are unavailable.
ALLOW_SYNTHETIC_FALLBACK=false

# ── AdaptLLM Remote-Sensing VLM Specialist (optional) ────────────────────────
# PRODUCTION/JUDGING MODE: false — AdaptLLM is disabled unless local weights
# are explicitly installed and this flag is set to true.
# Set ADAPTLLM_MODEL_PATH to the on-disk weights directory when enabling.
# Model NEVER auto-downloads weights regardless of this flag.
ENABLE_ADAPTLLM=false
# ADAPTLLM_MODEL_PATH=backend/models/generalist/adaptllm

# ── Session Call Limit ────────────────────────────────────────────────────────
# Soft per-session VLM call guard. Default production/demo value is 100 to allow
# comprehensive evaluation sessions while protecting against runaway loops.
SESSION_CALL_LIMIT=100
VITE_SESSION_CALL_LIMIT=100

# ── Frontend Origin (for Node server CORS) ────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:8443

# ── Demo Mode ────────────────────────────────────────────────────────────────
# Optional: set to true to show demo responses without real API calls.
# VITE_DEMO_MODE=false

# ── Phase 4: PostgreSQL Database ──────────────────────────────────────────────
# Connection string for the PostgreSQL database.
# The application runs without a database (in-memory mode) if not set.
# Example: postgresql://postgres:password@localhost:5432/satquery
DATABASE_URL=

# PostgreSQL connection pool settings
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Session and cache TTL in minutes (default: 30)
SESSION_TTL_MINUTES=30
CACHE_TTL_MINUTES=30
