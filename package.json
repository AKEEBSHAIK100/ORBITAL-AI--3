{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node scripts/dev-full.mjs",
    "api:dev": "tsx server.ts",
    "api:start": "node --import tsx server.ts",
    "backend:start": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "vite build",
    "start": "node --import tsx server.ts",
    "preview": "vite preview",
    "format": "oxfmt",
    "test:phase4": "node --import tsx tests/phase4.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@vercel/node": "^12.0.1",
    "@vitejs/plugin-react": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^7.10.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "three": "^0.185.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "devDependencies": {
    "oxfmt": "^0.2.0"
  },
  "engines": {
    "node": "24.x"
  }
}
