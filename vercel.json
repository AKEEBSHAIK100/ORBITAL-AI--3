{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/analyze/buildings",
      "destination": "/api/buildings"
    },
    {
      "source": "/analyze/fusion",
      "destination": "/api/fuse"
    },
    {
      "source": "/classify",
      "destination": "/api/classify"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
